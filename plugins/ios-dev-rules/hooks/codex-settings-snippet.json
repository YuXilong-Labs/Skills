{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // empty' | { read -r f; case \"$f\" in *.h|*.m|*.mm) clang-format -style=\"file:$HOME/.codex/rules/objectivec/.clang-format\" -i \"$f\" 2>/dev/null ;; esac; }",
            "timeout": 15,
            "statusMessage": "ObjC clang-format 格式化中..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "nohup bash \"$HOME/.codex/scripts/ios-dev-rules/check-and-upgrade.sh\" --mode=auto --target=codex >/dev/null 2>&1 &",
            "timeout": 3,
            "statusMessage": "ios-dev-rules 后台检查更新"
          }
        ]
      }
    ]
  }
}
